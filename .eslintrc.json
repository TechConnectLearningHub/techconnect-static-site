{
  "env": {
    "browser": true,
    "es2021": true,
    "jest": true
  },
  "extends": [
    "eslint:recommended"
  ],
  "parserOptions": {
    "ecmaVersion": 12,
    "sourceType": "module"
  },
  "rules": {
    "no-console": "off",
    "eqeqeq": ["error", "always"],
    "curly": "error",
    "no-unused-vars": ["warn", { "args": "none", "ignoreRestSiblings": true }],
    "semi": ["error", "always"]
  }
}
